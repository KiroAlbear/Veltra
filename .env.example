# Database
# Prisma is configured for PostgreSQL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth and encryption
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
ENCRYPTION_KEY="replace-with-a-32-byte-encryption-key"

# AI providers - optional. Demo fallbacks are used when omitted.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
GOOGLE_CLOUD_VISION_API_KEY=""

# Email - optional.
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# SMS and WhatsApp - optional.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER=""
WHATSAPP_VERIFY_TOKEN=""

# Billing - optional.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PLATFORM_MONTHLY=""
STRIPE_PRICE_PLATFORM_ANNUAL=""
STRIPE_PRICE_PLATFORM_3YEAR=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""
STRIPE_PRICE_FOUNDING_ANNUAL=""

# Backups and monitoring - optional.
BACKUP_S3_BUCKET=""
BACKUP_REPLICATION_REGION=""
SENTRY_DSN=""
